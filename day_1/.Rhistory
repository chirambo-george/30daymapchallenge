facilities <- facilities |>
filter(TYPE %in% c('Central Hospital', 'District Hospital',
'Hospital','Clinic', 'Rural Hospital',
'Health Centre', 'Mental Hospital',
))
facilities <- facilities |>
filter(TYPE == 'Central Hospital'|
TYPE == 'District Hospital'|
TYPE == 'Hospital'|
TYPE == 'Clinic'|
TYPE == 'Rural Hospital'|
TYPE == 'Health Centre'|
TYPE == 'Mental Hospital'
)
unique(facilities$TYPE)
options(tmap.component.autoscale = FALSE)
# points map
tm_basemap('CartoDB.DarkMatter') +
tm_shape(facilities) +
tm_symbols(col = 'TYPE',
size = 0.3,
shape = 21,
border.lwd = 0.1,
palette = 'brewer.set1',
title.col = 'Type of Facility') +
tm_layout(title = 'Health Facilities in Malawi',
)+
tm_style("classic")
